{
  "identifier": "run.vineyard.pluginpacks.x",
  "content_type": "vineyard:pluginpack",
  "name": "X (Twitter)",
  "version": "0.6.2",
  "description": "Collects public X (Twitter) profiles and recent posts for account nodes. Desktop only.",
  "author": {
    "name": "VINEYARD",
    "url": "https://github.com/Vineyard-Intelligence"
  },
  "license": "Apache-2.0",
  "icon": "bird",
  "platforms": {
    "primary": "desktop",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    },
    "desktop": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs",
      "min_app_version": "0.1.0"
    }
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.x_profile",
      "content_type": "vineyard:plugin",
      "name": "X Profile",
      "version": "0.6.2",
      "description": "Fetches the public X (Twitter) profile for each selected Social Account or Account node's username and writes it to the X Social Account node (created if absent): user_id, display name, bio, location, website, follower/following/post counts, verification, join date, avatar URL. Desktop only.",
      "icon": "bird",
      "platforms": {
        "primary": "desktop",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        },
        "desktop": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs",
          "min_app_version": "0.1.0"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.social",
            "category": "social",
            "name": "account"
          },
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "account"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.social",
            "category": "social",
            "name": "account"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://api.twitter.com",
            "methods": [
              "GET",
              "POST"
            ],
            "purpose": "Start a logged-out guest session on X."
          },
          {
            "endpoint": "https://twitter.com",
            "methods": [
              "GET"
            ],
            "purpose": "Read public data of the selected accounts from X."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
    {
      "identifier": "run.vineyard.plugins.x_posts",
      "content_type": "vineyard:plugin",
      "name": "X Posts",
      "version": "0.6.2",
      "description": "Collects recent X (Twitter) posts for each selected Social Account or Account node's username. Creates one Post node per post (text, time, language, engagement counts, permalink, media URLs) plus Hashtag and Media nodes, with \"posted by\", \"uses hashtag\", \"contains media\", \"reposted\" and \"replies to\" edges; if the selected node has no user_id, also creates or fills the X Social Account node the posts attach to. Up to count posts per account (default 20, max 100); some accounts return an empty timeline even though their posts are public. Desktop only.",
      "icon": "bird",
      "platforms": {
        "primary": "desktop",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        },
        "desktop": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs",
          "min_app_version": "0.1.0"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.social",
            "category": "social",
            "name": "account"
          },
          {
            "typepack": "run.vineyard.typepacks.identity",
            "category": "identity",
            "name": "account"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.social",
            "category": "social",
            "name": "account"
          },
          {
            "typepack": "run.vineyard.typepacks.social",
            "category": "social",
            "name": "post"
          },
          {
            "typepack": "run.vineyard.typepacks.social",
            "category": "social",
            "name": "hashtag"
          },
          {
            "typepack": "run.vineyard.typepacks.social",
            "category": "social",
            "name": "media"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "edge:create"
        ],
        "network": [
          {
            "endpoint": "https://api.twitter.com",
            "methods": [
              "GET",
              "POST"
            ],
            "purpose": "Start a logged-out guest session on X."
          },
          {
            "endpoint": "https://twitter.com",
            "methods": [
              "GET"
            ],
            "purpose": "Read public data of the selected accounts from X."
          }
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      },
      "params": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "title": "Posts",
            "description": "Maximum posts to collect per account, 1–100. Default 20.",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      }
    }
  ]
}
